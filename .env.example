# ============================================================
# 当前客户项目的配置。本 agent 一次服务一个项目,换客户时换这一整套值。
# .env* 已被 .gitignore 忽略(.env.example 是例外),请勿提交真实值。
# ============================================================

# --- 金数据(Jinshuju)---
# 开放平台 > API Key(企业版套餐可生成):https://open.jinshuju.net/mcp/
# connection 以 HTTP Basic 认证:Authorization: Basic base64(KEY:SECRET)。
# agent 会自动 base64,填明文即可,不要自己预先编码。
JINSHUJU_API_KEY=
JINSHUJU_API_SECRET=

# --- 微信小程序 ---
# 小程序 appid(微信公众平台 > 开发管理 > 开发设置)
WX_APPID=
# 代码上传密钥私钥文件路径(开发设置 > 小程序代码上传 生成;
# 需把 miniprogram-ci 运行环境的 IP 加入其上传 IP 白名单)。用于 upload_miniprogram。
WX_UPLOAD_PRIVATE_KEY_PATH=
# 小程序项目路径(相对 sandbox 的 /workspace),默认为当前目录
WX_PROJECT_PATH=.

# --- 微信云托管 ---
# 云托管环境 id,用于 deploy_cloudrun
WXCLOUD_ENV_ID=

# --- (可选)企业微信客服 ---
# 不接入客服可留空
WXWORK_CORP_ID=
WXWORK_KF_URL=

# 提醒:
# - 金数据企业版 Key 的调用来源 IP、以及小程序代码上传密钥的 IP,都要各自加白名单。
# - 云托管出口 IP 可能变化,建议配置固定公网出口,否则金数据白名单会失效。
