# ============================================================
# 当前客户项目的配置。本 agent 一次服务一个项目,换客户时换这一整套值。
# .env* 已被 .gitignore 忽略(.env.example 是例外),请勿提交真实值。
# ============================================================

# --- 金数据(Jinshuju)---
# 在金数据系统后台创建 Access Token；完整 Token 只显示一次，请立即安全保存：
# https://open.jinshuju.net/api_v1/authentication/
# agent 通过 Authorization: Bearer <token> 发送，填入原始 Token，不要自行加 Bearer 前缀。
JINSHUJU_ACCESS_TOKEN=

# --- 微信小程序 ---
# 小程序 appid(微信公众平台 > 开发管理 > 开发设置)
WX_APPID=
# 代码上传密钥私钥文件路径(开发设置 > 小程序代码上传 生成;
# 需把 miniprogram-ci 运行环境的 IP 加入其上传 IP 白名单)。用于 upload_miniprogram。
WX_UPLOAD_PRIVATE_KEY_PATH=
# 小程序项目路径(相对 sandbox 的 /workspace),默认为当前目录
WX_PROJECT_PATH=.

# --- 微信云托管 ---
# 云托管环境 id,用于 deploy_cloudrun
WXCLOUD_ENV_ID=
# 同一分支只能有一个云托管发布触发器，二选一：
# - pipeline: 云托管工作流监听代码仓库/分支；代码推送是唯一触发器，agent 禁止调用 deploy_cloudrun。
# - manual: 不配置该分支的自动发布工作流；agent 经审批后只调用一次 deploy_cloudrun。
# 未设置或填写其他值时，deploy_cloudrun 会拒绝执行，避免意外的第二次部署。
WXCLOUD_DEPLOY_MODE=pipeline

# --- (可选)企业微信客服 ---
# 不接入客服可留空
WXWORK_CORP_ID=
WXWORK_KF_URL=

# 提醒:
# - 金数据 Access Token 的调用来源 IP、以及小程序代码上传密钥的 IP,都要各自加白名单。
# - 云托管出口 IP 可能变化,建议配置固定公网出口,否则金数据白名单会失效。
